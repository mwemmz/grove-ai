# Vercel Postgres (Neon) — use the POOLED connection string (POSTGRES_URL) for serverless
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Clerk (https://dashboard.clerk.com) — frontend publishable key
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Clerk — backend secret key (never expose to the client)
CLERK_SECRET_KEY="sk_test_..."
